{
  "name": "svelte-gantt",
  "description": "Interactive JavaScript Gantt chart/resource booking component",
  "version": "4.5.0",
  "author": "Ante Novokmet <ante.je.zakon@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "autobuild": "rollup -c -w",
    "demo:dev": "cd demo && npm run dev",
    "dev": "run-p autobuild demo:dev",
    "validate": "svelte-check",
    "demokit:dev": "npm --prefix demo-sveltekit run dev",
    "package": "node tools/build && npm run build-package",
    "build-package": "svelte-package -i src -o dist/svelte",
    "lint": "eslint .",
    "format": "prettier --plugin-search-dir . --write . --plugin prettier-plugin-svelte",
    "test": "vitest"
  },
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts",
      "svelte": "./src/index.ts"
    },
    "./svelte": {
      "import": "./src/index.ts",
      "default": "./src/index.ts",
      "svelte": "./src/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ANovokmet/svelte-gantt.git"
  },
  "bugs": {
    "url": "https://github.com/ANovokmet/svelte-gantt/issues"
  },
  "keywords": [
    "svelte",
    "gantt",
    "booking",
    "svelte-gantt",
    "js-gantt",
    "javascript-gantt",
    "react-gantt",
    "angular-gantt",
    "vue-gantt",
    "drag-n-drop"
  ],
  "dependencies": {
    "@svelte-gantt/gantt-core": "*"
  },
  "peerDependencies": {
    "moment": "^2.22.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@rollup/plugin-typescript": "^11.1.4",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.2.7",
    "@tsconfig/svelte": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "del": "^5.1.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.45.1",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.3",
    "postcss": "^8.3.11",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "resize-observer-polyfill": "^1.5.1",
    "rollup": "^2.36.1",
    "rollup-plugin-buble": "^0.19.2",
    "rollup-plugin-postcss": "^4.0.1",
    "rollup-plugin-svelte": "^7.2.2",
    "rollup-plugin-uglify": "^3.0.0",
    "sirv-cli": "^2.0.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.1.1"
  }
}